# ==============================================================================
# TenantGuard - Environment Configuration Template (.env.example)
# NOTE: Deliberately weak defaults are configured for v0 educational purposes.
# ==============================================================================

# Application environment (development / production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL in Docker Compose, or SQLite fallback)
POSTGRES_USER=tenantguard
# Generate a secure database password: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_24
POSTGRES_DB=tenantguard_db

# In Docker Compose, the database URL is constructed from the credentials above:
DATABASE_URL=postgresql://tenantguard:CHANGE_ME_GENERATE_WITH_openssl_rand_base64_24@db:5432/tenantguard_db
# For local testing outside Docker, you can use:
# DATABASE_URL=sqlite:///./tenantguard.db

# Authentication / JWT Configuration
# REMEDIATION (FINDING-01 & FINDING-08): Secret MUST be at least 32 characters (256 bits).
# Generate with: openssl rand -hex 32  (or: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256

# Storage configuration
UPLOAD_DIR=/app/uploads
CHROMA_PERSIST_DIR=/app/chroma_data

# LLM Configuration (Google Gemini)
# Leave empty or set to 'mock' to use internal stub LLM service
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
